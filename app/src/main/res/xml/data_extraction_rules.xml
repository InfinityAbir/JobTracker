<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="job_tracker_db" />
        <include domain="database" path="job_tracker_db-shm" />
        <include domain="database" path="job_tracker_db-wal" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ai_settings.xml" />
        <include domain="file" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="job_tracker_db" />
        <include domain="database" path="job_tracker_db-shm" />
        <include domain="database" path="job_tracker_db-wal" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ai_settings.xml" />
        <include domain="file" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
